model RecommendationExposure {
  id                      String                        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workspaceId             String                        @map("workspace_id") @db.Uuid
  workspace               Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccountId         String                        @map("social_account_id") @db.Uuid
  socialAccount           SocialAccount                 @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  provenanceType          RecommendationProvenanceType  @default(INSIGHT) @map("provenance_type")

  insightId               String?                       @map("insight_id") @db.Uuid
  insight                 Insight?                      @relation(fields: [insightId, workspaceId, socialAccountId], references: [id, workspaceId, socialAccountId], onDelete: Restrict)

  learnedWeightId         String?                       @map("learned_weight_id") @db.Uuid
  learnedWeight           LearnedDimensionWeight?       @relation(fields: [learnedWeightId, workspaceId, socialAccountId], references: [id, workspaceId, socialAccountId], onDelete: Restrict)

  explorationDimension    AggregationDimension?         @map("exploration_dimension")
  explorationValue        String?                       @map("exploration_value")

  contentIdeaId           String?                       @unique @map("content_idea_id") @db.Uuid
  contentIdea             ContentIdea?                  @relation(fields: [contentIdeaId, workspaceId, socialAccountId], references: [id, workspaceId, socialAccountId])

  draftId                 String?                       @unique @map("draft_id") @db.Uuid
  draft                   ContentDraft?                 @relation(fields: [draftId], references: [id])

  publishedPostId         String?                       @unique @map("published_post_id") @db.Uuid
  publishedPost           PublishedPost?                @relation(fields: [publishedPostId, workspaceId, socialAccountId], references: [id, workspaceId, socialAccountId])

  evaluatedPostMetricId   String?                       @unique @map("evaluated_post_metric_id") @db.Uuid
  evaluatedPostMetric     PostMetric?                   @relation(fields: [evaluatedPostMetricId, workspaceId, socialAccountId], references: [id, workspaceId, socialAccountId])
  observedLift            Float?                        @map("observed_lift")

  attributionStatus       RecommendationAttributionStatus @default(EXPOSED) @map("attribution_status")
  analyticsRevisionAtGeneration Int                     @map("analytics_revision_at_generation")
  cycleIdempotencyKey     String                        @unique @map("cycle_idempotency_key")

  exposedAt               DateTime                      @default(now()) @map("exposed_at")
  acceptedAt              DateTime?                     @map("accepted_at")
  publishedAt             DateTime?                     @map("published_at")
  evaluatedAt             DateTime?                     @map("evaluated_at")

  createdAt               DateTime                      @default(now()) @map("created_at")
  updatedAt               DateTime                      @updatedAt @map("updated_at")

  @@unique([id, workspaceId, socialAccountId], name: "uq_recommendation_exposure_tenant")
  @@unique([contentIdeaId, workspaceId, socialAccountId], name: "uq_exposure_content_idea")
  @@unique([publishedPostId, workspaceId, socialAccountId], name: "uq_exposure_published_post")
  @@unique([evaluatedPostMetricId, workspaceId, socialAccountId], name: "uq_exposure_evaluated_post_metric")
  @@index([socialAccountId, attributionStatus])
  @@index([workspaceId, attributionStatus, createdAt])
  @@map("recommendation_exposures")
}

