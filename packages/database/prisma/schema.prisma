  percentDelta                Float?                @map("percent_delta")
  cohensD                     Float?                @map("cohens_d")
  degreesOfFreedom            Float?                @map("degrees_of_freedom")
  welchTStatistic             Float?                @map("welch_t_statistic")
  welchPValue                 Float?                @map("welch_p_value")
