[Unit]
Description=Daily ThreadPilot Encrypted Neon Backup Runner
After=network-online.target
Wants=network-online.target
OnFailure=threadpilot-backup-failure@%n.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
EnvironmentFile=/opt/threadpilot/.env.production
ExecStart=/opt/threadpilot/scripts/backup-neon.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
