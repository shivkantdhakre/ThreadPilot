# ─────────────────────────────────────────────────────────────────
# ThreadPilot — Environment Configuration
# Copy to .env — NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────

NODE_ENV=development

# ─── Public URLs (browser-facing) ────────────────────────────────
APP_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001

# ─── Internal URLs (container-to-container, used by web for SSR) ─
# Do NOT use localhost inside Docker containers — use service names.
API_INTERNAL_URL=http://api:3001

# ─── Ports ───────────────────────────────────────────────────────
API_PORT=3001
WORKER_PORT=3002
WEB_PORT=3000

# ─── Database ────────────────────────────────────────────────────
# Inside containers → uses 'postgres' (Docker service name)
# Host machine CLI (e.g. prisma studio) → uses DATABASE_URL_LOCAL
DATABASE_URL=postgresql://threadpilot:threadpilot@postgres:5432/threadpilot
DATABASE_URL_LOCAL=postgresql://threadpilot:threadpilot@localhost:5432/threadpilot
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ─── Redis ───────────────────────────────────────────────────────
# Inside containers → uses 'redis' (Docker service name)
REDIS_URL=redis://redis:6379
REDIS_URL_LOCAL=redis://localhost:6379
REDIS_KEY_PREFIX=tp:

# ─── JWT Auth ────────────────────────────────────────────────────
# Generate: openssl rand -base64 64
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_64_CHARS
JWT_ACCESS_EXPIRES_IN=15m
# Different from access secret
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_64_CHARS
JWT_REFRESH_EXPIRES_IN=30d
# Refresh token delivered as HttpOnly cookie
JWT_REFRESH_COOKIE_NAME=tp_rt
JWT_REFRESH_COOKIE_DOMAIN=localhost

# ─── Token Encryption (Threads OAuth tokens) ─────────────────────
# 32-byte key, base64-encoded. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64_KEY
# Increment when rotating key — old tokens prefixed with old version still decrypt correctly
TOKEN_ENCRYPTION_KEY_VERSION=1

# ─── Threads API ─────────────────────────────────────────────────
# Verify ALL values against current Meta developer documentation before use.
# These are config only — no Threads API surface area in source code.
THREADS_APP_ID=
THREADS_APP_SECRET=
# Local development: http://localhost:3001/api/v1/threads-auth/callback
# Production: https://api.yourdomain.com/api/v1/threads-auth/callback (Must match Meta App Dashboard)
THREADS_REDIRECT_URI=http://localhost:3001/api/v1/threads-auth/callback
THREADS_API_BASE_URL=https://graph.threads.net/v1.0

# Scopes — Phase 2: threads_basic,threads_content_publish
THREADS_SCOPES=threads_basic,threads_content_publish

# Rate limits — config only; actual quota from live Threads endpoint takes precedence.
THREADS_POST_RATE_LIMIT_PER_24H=250
THREADS_REPLY_RATE_LIMIT_PER_24H=1000

# OAuth PKCE state TTL in seconds (how long the state is valid before callback must arrive)
THREADS_OAUTH_STATE_TTL_SECONDS=300

# ─── AI — Gemini ─────────────────────────────────────────────────
# Server-side only — NEVER expose to browser.
# Use an authorization key (not a legacy standard API key).
# Free tier available — check current pricing at ai.google.dev/gemini-api/docs/pricing
GEMINI_API_KEY=
# Model names are config — changing a model requires only an env update, not a code change.
# Check current model catalog at ai.google.dev/gemini-api/docs/models
GEMINI_MODEL_CONTENT=gemini-2.5-flash
GEMINI_MODEL_CLASSIFICATION=gemini-2.0-flash-lite
GEMINI_MODEL_EMBEDDING=gemini-embedding-2
# Supported dimensions for gemini-embedding-2: 768 | 1536 | 3072
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_MAX_RETRIES=3
GEMINI_REQUEST_TIMEOUT_MS=30000
PRIMARY_AI_PROVIDER=gemini

# ─── Argon2id ────────────────────────────────────────────────────
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# ─── Logging ─────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_PRETTY=true

# ─── BullMQ ──────────────────────────────────────────────────────
BULLMQ_CONCURRENCY_INGESTION=2
BULLMQ_CONCURRENCY_CONTENT=3
BULLMQ_CONCURRENCY_STYLE=1

# ─── Dev-only (pgAdmin via Docker dev profile) ───────────────────
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin
