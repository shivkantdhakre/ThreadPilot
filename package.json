{
  "name": "threadpilot",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.6.5",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:gemini-live": "pnpm --filter @threadpilot/ai test:gemini-live",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:studio": "pnpm --filter=database db:studio",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
  "devDependencies": {
    "@threadpilot/database": "workspace:^",
    "@threadpilot/threads-client": "workspace:^",
    "@threadpilot/types": "workspace:^",
    "ioredis": "^5.4.1",
    "prettier": "^3.3.3",
    "turbo": "^2.5.3",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@google/genai",
      "@prisma/client",
      "@prisma/engines",
      "@scarf/scarf",
      "argon2",
      "msgpackr-extract",
      "prisma",
      "protobufjs"
    ]
  }
}
