# ─── Public URLs & Split Subdomains ─────────────────────────────────────────
APP_PUBLIC_URL=https://app.yourdomain.com
API_PUBLIC_URL=https://api.yourdomain.com
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
THREADS_REDIRECT_URI=https://api.yourdomain.com/api/v1/threads-auth/callback

# ─── Server & Ports ─────────────────────────────────────────────────────────
NODE_ENV=production
API_PORT=3001
WORKER_PORT=3002
PORT=3000

# ─── Database & Managed Redis ───────────────────────────────────────────────
# Pooled connection used by application runtime (Prisma Client)
DATABASE_URL=postgresql://user:password@ep-misty-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Direct unpooled connection used for Prisma migrations and pg_dump backups
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-misty.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Managed Redis TLS connection used by BullMQ
REDIS_URL=rediss://default:password@your-upstash-instance.upstash.io:6379

# ─── Auth & Security ────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your_minimum_32_character_jwt_access_secret_here
JWT_REFRESH_SECRET=your_minimum_32_character_jwt_refresh_secret_here
# Base64-encoded 32-byte AES-GCM key (generate via: node -e "console.log(crypto.randomBytes(32).toString('base64'))")
TOKEN_ENCRYPTION_KEY=base64_encoded_32_byte_aes_gcm_key_here
TOKEN_ENCRYPTION_KEY_VERSION=1
JWT_REFRESH_COOKIE_NAME=tp_rt
JWT_REFRESH_COOKIE_DOMAIN=.yourdomain.com
CORS_ORIGIN=https://app.yourdomain.com

# ─── Meta Threads OAuth & Graph API ─────────────────────────────────────────
THREADS_APP_ID=your_meta_threads_app_id
THREADS_APP_SECRET=your_meta_threads_app_secret
THREADS_SCOPES=threads_basic,threads_content_publish
THREADS_API_BASE_URL=https://graph.threads.net/v1.0
THREADS_OAUTH_STATE_TTL_SECONDS=300

# ─── AI Model Keys ──────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key

# ─── Disaster Recovery / Backup (Public Key Only on VM) ─────────────────────
# Age recipient public key for unattended encryption (generate via: age-keygen)
# Decryption identity (private key) is kept strictly in an offsite vault
AGE_RECIPIENT_PUBKEY=age1your_public_age_recipient_key_here
OCI_NAMESPACE=your_oci_tenancy_namespace
OCI_BACKUP_BUCKET=threadpilot-backups
